# Use the OpenAI-compatible inference URL for your Azure AI Foundry deployment,
# including the /openai/v1 path, for example:
# https://<resource>.services.ai.azure.com/openai/v1
FOUNDRY_BASE_URL=
FOUNDRY_API_KEY=
FOUNDRY_BASELINE_MODEL=
FOUNDRY_CUSTOMIZED_MODEL=

# Optional, used by scripts/upload_dataset.py after you create a storage account.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=ticket-training-data
